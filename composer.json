{
  "name": "jengo/api",
  "description": "Zero-boilerplate REST APIs for Jengo applications.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Ochieng",
      "email": "ochiengian383@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7",
    "jengo/base": "^1.1",
    "jengo/schema": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Jengo\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5|^13.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit"
  }
}
