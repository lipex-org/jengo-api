{
  "name": "jengo/api",
  "description": "Zero-boilerplate REST APIs for Jengo applications.",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "autoload": {
    "psr-4": {
      "Jengo\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "codeigniter4/framework": "^4.6",
    "jengo/base": "^1.1",
    "jengo/schema": "^1.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  }
}
